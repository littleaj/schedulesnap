{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "scheduleOwnerGuess": {
      "type": "string",
      "$comment": "name matched against target, if found"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "$comment": "warning message, e.g. 'Year not shown, assumed 2026'"
      }
    },
    "shifts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "$comment": "ISO 8601 date, e.g. '2026-09-05'"
          },
          "startTime": {
            "type": "string",
            "$comment": "ISO 8601 time, e.g. '14:30'"
          },
          "endTime": {
            "type": "string",
            "$comment": "ISO 8601 time, e.g. '18:30'"
          },
          "role": {
            "type": "string",
            "$comment": "Optional, e.g. 'Barista', 'Cashier'"
          },
          "location": {
            "type": "string",
            "$comment": "Optional, e.g. 'Main Street Cafe'"
          },
          "confidence": {
            "type": "number",
            "$comment": "0.0-1.0"
          },
          "rawText": {
            "type": "string",
            "$comment": "the literal text this was parsed from"
          },
          "boundingBox": {
            "type": "object",
            "$comment": "Bounding box coordinates normalized to 0-1000 scale relative to the resized image (max dimension 1024px)",
            "properties": {
              "xMin": {
                "type": "number",
                "$comment": "Minimum X coordinate (0-1000)"
              },
              "yMin": {
                "type": "number",
                "$comment": "Minimum Y coordinate (0-1000)"
              },
              "xMax": {
                "type": "number",
                "$comment": "Maximum X coordinate (0-1000)"
              },
              "yMax": {
                "type": "number",
                "$comment": "Maximum Y coordinate (0-1000)"
              }
            },
            "required": ["xMin", "yMin", "xMax", "yMax"]
          }
        },
        "required": [
          "date",
          "startTime",
          "endTime",
          "confidence",
          "rawText",
          "boundingBox"
        ]
      }
    }
  },
  "required": [
    "shifts",
    "warnings"
  ]
}
